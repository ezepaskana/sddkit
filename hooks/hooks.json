{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -f .sdd/config.json || cat \"${CLAUDE_PLUGIN_ROOT}/hooks/bootstrap.md\""
          },
          {
            "type": "command",
            "command": "test ! -d .sdd || command -v termaid >/dev/null 2>&1 || grep -q '\"termaid\"' .sdd/config.json 2>/dev/null || cat \"${CLAUDE_PLUGIN_ROOT}/hooks/termaid.md\""
          },
          {
            "type": "command",
            "command": "grep -q '\"caveman\"[[:space:]]*:[[:space:]]*\"no\"' .sdd/config.json 2>/dev/null || cat \"${CLAUDE_PLUGIN_ROOT}/hooks/caveman.md\""
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/debug-context.sh\" SessionStart"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/debug-context.sh\" PreToolUse"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/debug-context.sh\" SubagentStop"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/debug-context.sh\" SessionEnd"
          }
        ]
      }
    ]
  }
}
