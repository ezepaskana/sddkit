{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -f .sdd/config.json || cat \"${CLAUDE_PLUGIN_ROOT}/hooks/bootstrap.md\""
          },
          {
            "type": "command",
            "command": "test ! -d .sdd || command -v termaid >/dev/null 2>&1 || grep -q '\"termaid\"' .sdd/config.json 2>/dev/null || cat \"${CLAUDE_PLUGIN_ROOT}/hooks/termaid.md\""
          }
        ]
      }
    ]
  }
}
